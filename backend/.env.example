# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/interviewprep

# AI Provider
OPENAI_API_KEY=sk-your-openai-api-key-here

# LLM Models
LLM_MODEL_EVALUATION=gpt-4o
LLM_MODEL_GENERATION=gpt-4o-mini
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=30

# Interview
DEFAULT_QUESTION_BUDGET=10
MAX_FOLLOW_UPS_PER_TOPIC=2
PROMPT_VERSION=v1

# App
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
APP_VERSION=0.1.0
